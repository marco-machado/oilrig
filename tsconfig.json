{
  // Node-side files: build and test configs, scripts, Playwright specs. Each app and test
  // project has its own tsconfig (see `pnpm typecheck`).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["*.ts", "scripts", "tests/e2e", "apps/client/vite.config.ts", "apps/server/vite-wasm.ts"]
}
