        "ALLOW_SIGNUPS=true",
        "DRONE_STAY_MINUTES=4",
        "DRONE_AWAY_MINUTES=1",
        "pnpm",
        "--filter",
        "@oilrig/client",
        "exec",
        "vite",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
