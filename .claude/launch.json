{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ocean-home/client",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ocean-home/server",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "server-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8790",
        "DB_PATH=apps/server/data/alt.db",
        "DRONE_STAY_MINUTES=4",
        "DRONE_AWAY_MINUTES=1",
        "node",
        "apps/server/src/index.ts"
      ],
      "port": 8790
    },
    {
      "name": "client-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLIENT_PORT=5180",
        "SERVER_URL=http://localhost:8790",
        "pnpm",
        "--filter",
        "@ocean-home/client",
        "exec",
        "vite",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
