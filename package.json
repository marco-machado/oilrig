{
  "name": "oilrig",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm --filter @oilrig/client build",
    "start": "node apps/server/src/main.ts",
    "preview": "pnpm build && pnpm start",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/client && tsc -p apps/server && tsc -p tests/unit && tsc -p tests/server",
    "test:render": "playwright test tests/e2e/render.spec.ts",
    "test:auth": "playwright test tests/e2e/auth.spec.ts",
    "perf": "PERF=1 playwright test tests/e2e/perf.spec.ts",
    "trace": "TRACE=1 playwright test tests/e2e/trace.spec.ts",
    "trace:report": "node scripts/trace-report.ts",
    "bench": "node scripts/bench.ts",
    "screenshots": "SHOTS=1 playwright test tests/e2e/screenshots.spec.ts",
    "bot": "node scripts/bot.ts",
    "smoke": "node scripts/smoke.ts",
    "sfx": "node scripts/sfx.ts"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@oilrig/shared": "workspace:*",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "ws": "^8.23.0"
  }
}
