{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@oilrig/client", "dev"],
      "port": 5173
    },
    {
      "name": "client-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLIENT_PORT=5180",
        "CF_STATE=.wrangler/state-alt",
